# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/shopsphere_db

# JWT Secret Key for Authentication
JWT_SECRET=shopsphere_super_secret_jwt_token_2026_codealpha

# Client Base URL (optional for CORS)
CLIENT_URL=http://localhost:5000
